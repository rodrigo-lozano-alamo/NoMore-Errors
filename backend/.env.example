# Copia este archivo como .env y rellena solo las variables que uses.

# IA (Claude, de Anthropic) — sin clave, la app responde solo con el catálogo local
# Consigue la clave en https://console.anthropic.com
ANTHROPIC_API_KEY=
NOMORE_CLAUDE_MODEL=claude-opus-5-5
# Esfuerzo de razonamiento: low (más rápido y barato), medium, high
# NOMORE_CLAUDE_EFFORT=low

# Reddit (búsqueda pública JSON, no requiere credenciales)
REDDIT_USER_AGENT=NoMoreErrors/0.1 (contacto: tu-email@example.com)

# OCR — solo si tesseract.exe no está en el PATH
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Base de datos de feedback (por defecto backend/data/feedback.db)
# FEEDBACK_DB_PATH=
